direction: right

session: session {
  shape: page
}
backends: backends {
  db: database.py {
    backend: DatabaseBackend {
      tooltip: "listen, load, forget, keep, link; initialize and shutdown"
    }
    worker: one worker thread {
      tooltip: "every SQLAlchemy call runs here, in order, off the loop"
    }
    tables: messages and attachments {
      shape: cylinder
      tooltip: "ArchivedMessage keyed by message id; ArchivedAttachment keyed by (msg_id, name)"
    }
    files: temp directory {
      shape: page
      tooltip: "a file per linked attachment, removed at shutdown"
    }
    backend -> worker: work, awaited
    worker -> tables: merge, query, delete
    worker -> files: written on the first link
  }
}

session -> backends.db.backend: every message (listen), attachments before posting (keep)
session -> backends.db.backend: load at start, forget, link for locate
