direction: down

peers: peers, commands and roles {
  shape: page
}
builder: builder.py {
  tooltip: "build_chat_session, build_mcp_session"
}
framework: framework {
  session: session.py {
    tooltip: "ChatSession: registers, grants, delivers, starts and closes"
  }
  hooks: hooks.py {
    tooltip: "the hooks, @require, the naming decorators, the grant protocols"
  }
  query: query.py {
    tooltip: "Query and SELF"
  }
  message: message.py {
    tooltip: "ChatMessage, MessageID, MessageStore, Reply, Attachment, Secret"
  }
  session -> hooks: what each object declared
  session -> message: posts and stores messages
  session -> query: selects for context
  hooks -> message: types of the grants
  hooks -> query: type of context
  query -> message: reads messages
}

builder -> framework.session: a session with its frontend
peers -> framework.hooks: declare hooks
framework.session -> peers: grants, deliveries, lifecycle
