direction: right

model: "support/kits/model" {
  endpoint: "EndpointModel\ncomplete(messages, api_key)"
  chat: "EndpointChatModel\nLangChain face"
  lent: "lent_key(msg, credential)"
  chat -> endpoint: "own key, URL, model, headers"
}

openai_sdk: "openai SDK"
langchain: "langchain-openai"

connector: "OpenAIConnector"
router: "LLMRouter"
agent: "AgentPeer"

connector -> model.endpoint: "complete, lent key"
router -> model.endpoint: "complete, lent key"
agent -> model.chat: "configurable api_key"
model.endpoint -> openai_sdk: "AsyncOpenAI per key"
model.chat -> langchain: "ChatOpenAI per key"
